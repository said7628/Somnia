:root {
}

.contenedor {
}

.botones {
    flex-direction: row;
    justify-content: space-around;
    align-self: flex-end;
    height: 20px;
    align-items: flex-end;
    translate: -585px 23px;
    margin-bottom: 0;
}

.botonOjos {
    height: 210px;
    width: 120px;
    background-image: url("project://database/Assets/Imagenes%20Somnia/Tienda/Botones/activados/ojos%20activado%20120x210.png?fileID=2800000&guid=0eb5bfe79c8d3914ba0e6dc165cb61a2&type=3#ojos activado 120x210");
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    translate: 0 49px;
    margin-right: 20px;
}

.botonColor {
    width: 122px;
    height: 122px;
    background-image: url("project://database/Assets/Imagenes%20Somnia/Tienda/Botones/desactivados/color%20desativado%20122x122.png?fileID=2800000&guid=46af73b4029e7eb4cbe8eb4396075bee&type=3#color desativado 122x122");
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    margin-right: 0;
}

.botonOutfit {
    width: 122px;
    height: 122px;
    background-image: url("project://database/Assets/Imagenes%20Somnia/Tienda/Botones/desactivados/outfit%20desactivado%20122x122.png?fileID=2800000&guid=7e20aeb0aa3bae34f8644501024f5c62&type=3#outfit desactivado 122x122");
