    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    margin-left: 20px;
}

.puesto {
    flex-direction: row;
    height: 200px;
}

.yatzis {
    height: 1px;
}

.ojosIsla1 {
    flex-direction: row;
    align-self: center;
    justify-content: center;
    width: 10px;
    translate: -229px -5px;
}

.ojosRombo {
    background-image: url("project://database/Assets/Imagenes%20Somnia/Tienda/ojos/isla%201/rombo%20160x360.png?fileID=2800000&guid=f929e149898cfb34a80b83ec0855c758&type=3#rombo 160x360");
    width: 160px;
    height: 359px;
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    margin-right: 60px;
    align-self: center;
}

.ojosCansado {
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Imagenes%20Somnia/Tienda/ojos/isla%201/cansado%20160x360.png?fileID=4224106898562449350&guid=360e3f53d7f046641a8c9bd81c7e5997&type=3#cansado_0");
    background-color: rgba(0, 0, 0, 0);
    width: 160px;
    height: 359px;
    margin-left: 65px;
}



.soldOut {
    background-image: url("project://database/Assets/Imagenes%20Somnia/Tienda/Base/Sold%20Out%20160x360.png?fileID=4108043143474587792&guid=b2768c560b7ab814388f4292a641b915&type=3#Sold Out_0");
    width: 160px;
    height: 370px;
    translate: -15px -10px;
    position: absolute;
}

.cerrar {
    background-image: url("project://database/Assets/Imagenes%20Somnia/HUD/Inventario/tache%2077x77.png?fileID=7707315224208153258&guid=8baca84e2db8fcb449b6a2491a8d0c16&type=3#tache 77x77_0");
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0);
    width: 77px;
    height: 77px;
    align-self: flex-end;
    align-items: flex-start;
    justify-content: flex-start;
    align-content: auto;
    position: absolute;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    translate: 500px 0;
}
