}

.iconoMusica {
    background-image: url("project://database/Assets/Imagenes%20Somnia/HUD/Inventario/config/icono%20musica%20170x165.png?fileID=2800000&guid=5f5cc7fe62dc1304ebd6d73173e9e15d&type=3#icono musica 170x165");
