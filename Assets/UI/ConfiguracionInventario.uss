    height: 165px;
}

.iconoVoz {
    width: 170px;
    height: 165px;
    background-image: url("project://database/Assets/Imagenes%20Somnia/HUD/Inventario/config/icono%20voz%20170x165.png?fileID=2800000&guid=7187e25e8a09cb64bb3036ae18fc1d05&type=3#icono voz 170x165");
