                <ui:Button text="" name="BtnRopa" style="background-image: url(&quot;project://database/Assets/Imagenes%20Somnia/Tienda/Botones/desactivados/outfit%20desactivado%20122x122.png?fileID=2800000&amp;guid=7e20aeb0aa3bae34f8644501024f5c62&amp;type=3#outfit desactivado 122x122&quot;); background-color: rgba(149, 149, 149, 0); width: 110px; height: 110px; margin-left: 45px; border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0);"/>
