        <ui:VisualElement name="LadoTienda" picking-mode="Ignore" style="flex-grow: 1; flex-direction: column; flex-wrap: wrap; align-items: center; justify-content: flex-start; width: 50%;">
            <ui:VisualElement name="BotonesTienda" picking-mode="Ignore" class="contenedor-botones" style="flex-grow: 0; background-color: rgba(0, 0, 0, 0); flex-direction: row; align-items: center; justify-content: center; position: relative; top: auto; right: auto; padding-top: 0; padding-left: 0; padding-right: 0; margin-right: 0; margin-top: 250px; margin-bottom: 0; align-self: center;">
                <ui:Button text="" name="BtnOjos" style="background-image: url(&quot;project://database/Assets/Imagenes%20Somnia/Tienda/Botones/desactivados/ojos%20desactivado%20122x122.png?fileID=2800000&amp;guid=2b4ddb2b8b13f7847957de1f586fadc2&amp;type=3#ojos desactivado 122x122&quot;); background-color: rgba(149, 149, 149, 0); width: 110px; height: 110px; margin-left: 45px; border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0);"/>
