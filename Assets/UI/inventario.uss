    background-image: url("project://database/Assets/Imagenes%20Somnia/HUD/Inventario/color/blanco%20163x163.png?fileID=7751551136012658776&guid=4d955961874bd944bb53da0ab6b88ffd&type=3#blanco 163x163_0");
}

.default-ojos-preview {
    background-image: url("project://database/Assets/Imagenes%20Somnia/HUD/Inventario/cara/base%20163x163.png?fileID=2800000&guid=c4d413ee2b09a1e49acc14367477ff2a&type=3#base 163x163");
}

.default-outfit-preview {
    background-image: url("project://database/Assets/Imagenes%20Somnia/HUD/Inventario/outfit/boy%20scout%20233x233.png?fileID=2800000&guid=62989f371143f1f4a801427b30a04edb&type=3#boy scout 233x233");
}

.inventory-equipped {
    border-left-color: rgb(90, 228, 149);
    border-right-color: rgb(90, 228, 149);
    border-top-color: rgb(90, 228, 149);
    border-bottom-color: rgb(90, 228, 149);
    border-left-width: 5px;
    border-right-width: 5px;
    border-top-width: 5px;
    border-bottom-width: 5px;
}

.inventoryStatusLabel {
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    font-size: 18px;
    width: 520px;
    margin-left: 60px;
    margin-bottom: 8px;
}

.inventoryLoadingOverlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(2, 9, 19, 0.75);
    display: none;
}

.inventoryLoadingText {
    color: white;
    font-size: 24px;
    -unity-font-style: bold;
}

.inventory-tab-active {
    -unity-background-image-tint-color: rgb(255, 255, 255);
    opacity: 1;
}

.inventory-item-card {
    width: 155px;
    min-height: 172px;
    margin-top: 8px;
    margin-bottom: 10px;
    margin-left: 6px;
    margin-right: 6px;
    background-color: rgba(13, 20, 30, 0.72);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(50, 92, 130);
    border-right-color: rgb(50, 92, 130);
    border-top-color: rgb(50, 92, 130);
    border-bottom-color: rgb(50, 92, 130);
    border-radius: 12px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 8px;
    padding-bottom: 8px;
}

.inventory-item-card.locked {
    opacity: 0.42;
}

.inventory-item-card.equipped {
    border-left-color: rgb(90, 228, 149);
    border-right-color: rgb(90, 228, 149);
    border-top-color: rgb(90, 228, 149);
    border-bottom-color: rgb(90, 228, 149);
}

.inventory-item-icon {
    width: 100%;
    height: 84px;
    margin-bottom: 6px;
    background-color: rgba(255, 255, 255, 0.08);
    -unity-background-scale-mode: scale-to-fit;
    background-position-x: center;
    background-position-y: center;
}

.inventory-item-name {
    color: rgb(255, 255, 255);
    font-size: 13px;
    -unity-font-style: bold;
    unity-text-align: middle-center;
}

.inventory-item-state {
    margin-top: 4px;
    color: rgb(207, 224, 245);
    font-size: 11px;
    unity-text-align: middle-center;
}