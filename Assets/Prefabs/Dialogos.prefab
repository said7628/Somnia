  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SistemaDialogoCanvas
  canvasDialogo: {fileID: 2154141518111586214}
  tagJugador: Jugador
  jugador: {fileID: 8435796554160856347}
  opaco: {fileID: 7310805134996225829}
  npc: {fileID: 821303122261468050}
  dialogoText: {fileID: 6354307891757878875}
  opciones: {fileID: 9221586703413813469}
  siguiente: {fileID: 5710897536108130393}
  opcion1: {fileID: 507731147399778366}
  opcion2: {fileID: 4537637901737552144}
  opcion3: {fileID: 3440379848339853216}
  opcionText1: {fileID: 114435646140426142}
  opcionText2: {fileID: 6534438998467681986}
  opcionText3: {fileID: 2508038577106150495}
  audioEscritura: {fileID: 0}
  audioError: {fileID: 0}
  velocidadEscritura: 0.03
  pausaDespuesRespuesta: 0.7
  lineas:
  - hablante: 1
    texto: "T\xFA:\nHola, \xBFsabes d\xF3nde estamos?"
    esPregunta: 0
    respuestaCorrecta: 
    indiceCorrecto: 0
    opcion1: 
    opcion2: 
    opcion3: 
  - hablante: 0
    texto: "Circe:\n\xA1Hola! Me llamo Circe. Estamos en una especie de bosque encantado.
      La verdad, no s\xE9 exactamente d\xF3nde estamos."
    esPregunta: 0
    respuestaCorrecta: 
    indiceCorrecto: 0
    opcion1: 
    opcion2: 
    opcion3: 
  - hablante: 1
    texto: "T\xFA:\nNo esperaba encontrar un lugar as\xED. Es muy m\xE1gico."
    esPregunta: 0
    respuestaCorrecta: 
    indiceCorrecto: 0
    opcion1: 
    opcion2: 
    opcion3: 
  - hablante: 0
    texto: "Circe:\n\xA1Lo s\xE9, es incre\xEDble! Quiero descubrir todo sobre \xE9l.
