    - target: {fileID: 1960092015581716475, guid: c9441ff2343ede540b2c90eba8e7630a, type: 3}
      propertyPath: audioError
      value: 
      objectReference: {fileID: 543285065}
    - target: {fileID: 1960092015581716475, guid: c9441ff2343ede540b2c90eba8e7630a, type: 3}
      propertyPath: audioEscritura
      value: 
      objectReference: {fileID: 2108619039}
    - target: {fileID: 1960092015581716475, guid: c9441ff2343ede540b2c90eba8e7630a, type: 3}
      propertyPath: lineas.Array.size
      value: 8
      objectReference: {fileID: 0}
    - target: {fileID: 1960092015581716475, guid: c9441ff2343ede540b2c90eba8e7630a, type: 3}
      propertyPath: lineas.Array.data[0].texto
      value: "???:\nAsh, \xBFqu\xE9 es este lugar?"
      objectReference: {fileID: 0}
    - target: {fileID: 1960092015581716475, guid: c9441ff2343ede540b2c90eba8e7630a, type: 3}
      propertyPath: lineas.Array.data[1].texto
      value: "T\xFA:\nHola, \xBFest\xE1s bien?"
      objectReference: {fileID: 0}
    - target: {fileID: 1960092015581716475, guid: c9441ff2343ede540b2c90eba8e7630a, type: 3}
      propertyPath: lineas.Array.data[2].texto
      value: '???:

        Este lugar no me gusta. Yo estaba en paz en mi casa,
        y este lugar me hace estar _____.'
      objectReference: {fileID: 0}
    - target: {fileID: 1960092015581716475, guid: c9441ff2343ede540b2c90eba8e7630a, type: 3}
      propertyPath: lineas.Array.data[3].texto
      value: "T\xFA:\nOh, ya veo. \xBFY c\xF3mo te llamas?\n"
      objectReference: {fileID: 0}
    - target: {fileID: 1960092015581716475, guid: c9441ff2343ede540b2c90eba8e7630a, type: 3}
      propertyPath: lineas.Array.data[4].texto
      value: "Barbatos:\nPerd\xF3n por no presentarme. Me llamo Barbatos, un gusto.
        Empezamos con el pie equivocado."
      objectReference: {fileID: 0}
    - target: {fileID: 1960092015581716475, guid: c9441ff2343ede540b2c90eba8e7630a, type: 3}
      propertyPath: lineas.Array.data[5].texto
      value: "T\xFA:\nNo te preocupes, te ve\xEDas muy furioso."
      objectReference: {fileID: 0}
    - target: {fileID: 1960092015581716475, guid: c9441ff2343ede540b2c90eba8e7630a, type: 3}
      propertyPath: lineas.Array.data[6].texto
      value: 'Barbatos:

        Es que no estoy acostumbrado a salir de mi zona
        de confort.'
      objectReference: {fileID: 0}
    - target: {fileID: 1960092015581716475, guid: c9441ff2343ede540b2c90eba8e7630a, type: 3}
      propertyPath: lineas.Array.data[7].texto
      value: "T\xFA:\nLo s\xE9, puede llegar a molestarnos, pero vas a ver que pronto
        vamos a salir de esto."
      objectReference: {fileID: 0}
    - target: {fileID: 1960092015581716475, guid: c9441ff2343ede540b2c90eba8e7630a, type: 3}
      propertyPath: lineas.Array.data[2].opcion1
      value: enojado
      objectReference: {fileID: 0}
    - target: {fileID: 1960092015581716475, guid: c9441ff2343ede540b2c90eba8e7630a, type: 3}
      propertyPath: lineas.Array.data[2].opcion2
      value: enogado
      objectReference: {fileID: 0}
    - target: {fileID: 1960092015581716475, guid: c9441ff2343ede540b2c90eba8e7630a, type: 3}
      propertyPath: lineas.Array.data[2].opcion3
      value: Enojado
      objectReference: {fileID: 0}
    - target: {fileID: 1960092015581716475, guid: c9441ff2343ede540b2c90eba8e7630a, type: 3}
      propertyPath: lineas.Array.data[3].opcion1
