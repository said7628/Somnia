    - target: {fileID: 1960092015581716475, guid: c9441ff2343ede540b2c90eba8e7630a, type: 3}
      propertyPath: audioError
      value: 
      objectReference: {fileID: 1960307305}
    - target: {fileID: 1960092015581716475, guid: c9441ff2343ede540b2c90eba8e7630a, type: 3}
      propertyPath: audioEscritura
      value: 
      objectReference: {fileID: 1145060480}
    - target: {fileID: 1960092015581716475, guid: c9441ff2343ede540b2c90eba8e7630a, type: 3}
      propertyPath: lineas.Array.size
      value: 8
      objectReference: {fileID: 0}
    - target: {fileID: 1960092015581716475, guid: c9441ff2343ede540b2c90eba8e7630a, type: 3}
      propertyPath: lineas.Array.data[0].texto
      value: "T\xFA:\nHola, mucho gusto. \xBFC\xF3mo te llamas?"
      objectReference: {fileID: 0}
    - target: {fileID: 1960092015581716475, guid: c9441ff2343ede540b2c90eba8e7630a, type: 3}
      propertyPath: lineas.Array.data[1].texto
      value: 'Saloth:

        Hola, me llamo Saloth.'
      objectReference: {fileID: 0}
    - target: {fileID: 1960092015581716475, guid: c9441ff2343ede540b2c90eba8e7630a, type: 3}
      propertyPath: lineas.Array.data[2].texto
      value: "T\xFA:\nAh, mucho gusto, Saloth.\nNo s\xE9 qu\xE9 est\xE1 pasando aqu\xED.
        Hace un rato estaba aqu\xED, pero ahora parece un poco diferente."
      objectReference: {fileID: 0}
    - target: {fileID: 1960092015581716475, guid: c9441ff2343ede540b2c90eba8e7630a, type: 3}
      propertyPath: lineas.Array.data[3].texto
      value: 'Saloth:

        Yo estaba con mis amigos y mi familia. Ando muy ------
        por no verlos.'
      objectReference: {fileID: 0}
    - target: {fileID: 1960092015581716475, guid: c9441ff2343ede540b2c90eba8e7630a, type: 3}
      propertyPath: lineas.Array.data[4].texto
      value: "T\xFA:\n\xBFQuieres que seamos amigos? As\xED ahora vas a tener un
        amigo con quien estar."
      objectReference: {fileID: 0}
    - target: {fileID: 1960092015581716475, guid: c9441ff2343ede540b2c90eba8e7630a, type: 3}
      propertyPath: lineas.Array.data[5].texto
      value: "Saloth:\nEso estar\xEDa bien."
      objectReference: {fileID: 0}
    - target: {fileID: 1960092015581716475, guid: c9441ff2343ede540b2c90eba8e7630a, type: 3}
      propertyPath: lineas.Array.data[6].texto
      value: "T\xFA:\nS\xE9 que s\xED. Sabes, yo tambi\xE9n me perd\xED de mis amigos
        y de mi familia, pero s\xE9 que podremos encontrarlos."
      objectReference: {fileID: 0}
    - target: {fileID: 1960092015581716475, guid: c9441ff2343ede540b2c90eba8e7630a, type: 3}
      propertyPath: lineas.Array.data[7].texto
      value: 'Saloth:

        Eso espero.'
      objectReference: {fileID: 0}
    - target: {fileID: 1960092015581716475, guid: c9441ff2343ede540b2c90eba8e7630a, type: 3}
      propertyPath: lineas.Array.data[3].opcion1
      value: Triste
      objectReference: {fileID: 0}
    - target: {fileID: 1960092015581716475, guid: c9441ff2343ede540b2c90eba8e7630a, type: 3}
