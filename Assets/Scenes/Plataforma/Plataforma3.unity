    - target: {fileID: 1960092015581716475, guid: c9441ff2343ede540b2c90eba8e7630a, type: 3}
      propertyPath: audioError
      value: 
      objectReference: {fileID: 770678380}
    - target: {fileID: 1960092015581716475, guid: c9441ff2343ede540b2c90eba8e7630a, type: 3}
      propertyPath: audioEscritura
      value: 
      objectReference: {fileID: 687889799}
    - target: {fileID: 1960092015581716475, guid: c9441ff2343ede540b2c90eba8e7630a, type: 3}
      propertyPath: lineas.Array.size
      value: 10
      objectReference: {fileID: 0}
    - target: {fileID: 1960092015581716475, guid: c9441ff2343ede540b2c90eba8e7630a, type: 3}
      propertyPath: lineas.Array.data[0].texto
      value: "T\xFA:\nHola"
      objectReference: {fileID: 0}
    - target: {fileID: 1960092015581716475, guid: c9441ff2343ede540b2c90eba8e7630a, type: 3}
      propertyPath: lineas.Array.data[1].texto
      value: "???:\n\xA1AHHHH! \xBFQui\xE9n anda ah\xED?"
      objectReference: {fileID: 0}
    - target: {fileID: 1960092015581716475, guid: c9441ff2343ede540b2c90eba8e7630a, type: 3}
      propertyPath: lineas.Array.data[2].texto
      value: "T\xFA:\nHola, solo soy yo. Mucho gusto, \xBFc\xF3mo te llamas?"
      objectReference: {fileID: 0}
    - target: {fileID: 1960092015581716475, guid: c9441ff2343ede540b2c90eba8e7630a, type: 3}
      propertyPath: lineas.Array.data[3].texto
      value: "Zuri:\nHola, me llamo Zuri. Perd\xF3n por mi reacci\xF3n, es que me
        espantaste.\n"
      objectReference: {fileID: 0}
    - target: {fileID: 1960092015581716475, guid: c9441ff2343ede540b2c90eba8e7630a, type: 3}
      propertyPath: lineas.Array.data[4].texto
      value: "T\xFA:\nLo siento. Es que no entiendo este lugar cambia mucho y ando
        conociendo mucha gente nueva."
      objectReference: {fileID: 0}
    - target: {fileID: 1960092015581716475, guid: c9441ff2343ede540b2c90eba8e7630a, type: 3}
      propertyPath: lineas.Array.data[5].texto
      value: "Zuri:\nA m\xED me da ----- este lugar. Es todo muy nuevo."
      objectReference: {fileID: 0}
    - target: {fileID: 1960092015581716475, guid: c9441ff2343ede540b2c90eba8e7630a, type: 3}
      propertyPath: lineas.Array.data[6].texto
      value: "T\xFA:\nS\xE9 que descubrir cosas nuevas puede causarte miedo. \xBFQuieres
        que seamos amigos?"
      objectReference: {fileID: 0}
    - target: {fileID: 1960092015581716475, guid: c9441ff2343ede540b2c90eba8e7630a, type: 3}
      propertyPath: lineas.Array.data[7].texto
      value: 'Zuri:

        Claro, es mejor estar con un amigo.'
      objectReference: {fileID: 0}
    - target: {fileID: 1960092015581716475, guid: c9441ff2343ede540b2c90eba8e7630a, type: 3}
      propertyPath: lineas.Array.data[9].texto
      value: "T\xFA:\n\xA1Esa es la actitud! Vas a ver que juntos somos m\xE1s valientes."
      objectReference: {fileID: 0}
    - target: {fileID: 1960092015581716475, guid: c9441ff2343ede540b2c90eba8e7630a, type: 3}
      propertyPath: lineas.Array.data[5].opcion1
      value: temor
      objectReference: {fileID: 0}
    - target: {fileID: 1960092015581716475, guid: c9441ff2343ede540b2c90eba8e7630a, type: 3}
      propertyPath: lineas.Array.data[5].opcion2
      value: Temor
      objectReference: {fileID: 0}
    - target: {fileID: 1960092015581716475, guid: c9441ff2343ede540b2c90eba8e7630a, type: 3}
      propertyPath: lineas.Array.data[5].opcion3
      value: "tem\xF3r"
      objectReference: {fileID: 0}
    - target: {fileID: 1960092015581716475, guid: c9441ff2343ede540b2c90eba8e7630a, type: 3}
      propertyPath: lineas.Array.data[5].hablante
